APP_NAME="Petite Côte Villas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.petitecotevillas.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=petite_cote_villas
DB_USERNAME=villa
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# API Brevo (pas le relais SMTP, qui exige une IP autorisée payante) :
# brevo.com → SMTP et API → Clés API et MCP → Générer une nouvelle clé API.
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-reply@demosn.cloud"
MAIL_FROM_NAME="${APP_NAME}"

PROPERTIES_DRIVER=local

PLATFORM_COMMISSION_RATE=10
BOOKING_HOLD_MINUTES=30
PAYMENT_GATEWAY=manual

# Compte créé une seule fois par le seeder — changer ces valeurs après coup
# ne modifie pas le compte déjà créé.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Numéro affiché sur le site, sans espaces ni "+".
WHATSAPP_NUMBER=
WHATSAPP_DRIVER=log
