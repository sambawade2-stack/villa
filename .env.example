APP_NAME="Petite Côte Villas"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=petite_cote_villas
DB_USERNAME=villa
DB_PASSWORD=

# Base dédiée aux tests (voir phpunit.xml)
DB_TEST_DATABASE=petite_cote_villas_test

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (HTTPS obligatoire) ; à false uniquement en local sans certificat.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Cloudflare R2 (production) : AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# Plateforme
PLATFORM_COMMISSION_RATE=10
BOOKING_HOLD_MINUTES=30
PAYMENT_GATEWAY=manual

# Compte administrateur créé par le seeder. Ne jamais committer de vraie valeur.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
PROPERTIES_DRIVER=local

# Barre de débogage : à activer ponctuellement pour inspecter les requêtes SQL.
DEBUGBAR_ENABLED=false

# WhatsApp — lien direct (fonctionne sans compte développeur)
WHATSAPP_NUMBER=221770000000

# WhatsApp Cloud API (Meta) : « log » tant que les identifiants manquent.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
